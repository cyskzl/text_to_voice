# 服务器配置
PORT=3000

# 京东支付配置
JD_MERCHANT_ID=your_merchant_id
JD_APP_ID=your_app_id
JD_PRIVATE_KEY=your_private_key
JD_PUBLIC_KEY=jd_public_key
