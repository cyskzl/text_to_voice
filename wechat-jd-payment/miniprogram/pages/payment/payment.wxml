<view class="container">
  <view class="order-info">
    <view class="section-title">订单信息</view>
    <view class="info-item">
      <text class="label">商品名称：</text>
      <text class="value">{{productName}}</text>
    </view>
    <view class="info-item">
      <text class="label">商品价格：</text>
      <text class="value price">¥{{price}}</text>
    </view>
    <view class="info-item">
      <text class="label">订单号：</text>
      <text class="value">{{orderId}}</text>
    </view>
  </view>

  <view class="payment-methods">
    <view class="section-title">选择支付方式</view>
    <view class="method-list">
      <view class="method-item" bindtap="selectPayMethod" data-method="jd">
        <image class="method-icon" src="/images/jd-pay.png"></image>
        <text class="method-name">京东支付</text>
        <view class="method-check {{payMethod === 'jd' ? 'checked' : ''}}"></view>
      </view>
    </view>
  </view>

  <view class="bottom-bar">
    <view class="total-amount">
      <text class="label">应付金额：</text>
      <text class="amount">¥{{price}}</text>
    </view>
    <button class="pay-btn" bindtap="confirmPay" disabled="{{!payMethod}}">确认支付</button>
  </view>
</view>