<!--pages/payment/payment.wxml-->
<view class="container">
  <!-- 订单信息 -->
  <view class="order-info">
    <view class="order-header">
      <text class="order-title">订单信息</text>
      <text class="order-id">订单号：{{orderId}}</text>
    </view>
    
    <view class="product-detail">
      <view class="product-name">{{productInfo.name}}</view>
      <view class="product-price">¥{{productInfo.price}}</view>
    </view>
  </view>

  <!-- 支付方式 -->
  <view class="payment-section">
    <view class="section-title">选择支付方式</view>
    
    <view class="payment-methods">
      <view 
        class="payment-item {{selectedPayment === item.id ? 'selected' : ''}}"
        wx:for="{{paymentMethods}}" 
        wx:key="id"
        bindtap="selectPayment"
        data-id="{{item.id}}"
      >
        <image class="payment-icon" src="{{item.icon}}" mode="aspectFit"></image>
        <view class="payment-info">
          <text class="payment-name">{{item.name}}</text>
          <text class="payment-desc">{{item.desc}}</text>
        </view>
        <view class="payment-radio">
          <view class="radio-inner {{selectedPayment === item.id ? 'checked' : ''}}"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 支付说明 -->
  <view class="payment-notice" wx:if="{{selectedPayment === 'jdpay'}}">
    <view class="notice-title">京东支付说明</view>
    <view class="notice-content">
      <text class="notice-item">• 点击确认支付后，将跳转到京东支付页面</text>
      <text class="notice-item">• 请在京东支付页面完成支付操作</text>
      <text class="notice-item">• 支付完成后会自动返回小程序</text>
      <text class="notice-item">• 支持京东钱包、银行卡等多种支付方式</text>
    </view>
  </view>

  <!-- 总价和支付按钮 -->
  <view class="payment-footer">
    <view class="total-price">
      <text class="total-label">实付金额：</text>
      <text class="total-amount">¥{{productInfo.price}}</text>
    </view>
    
    <button 
      class="pay-button {{loading ? 'loading' : ''}}"
      bindtap="confirmPayment"
      loading="{{loading}}"
    >
      {{loading ? '处理中...' : '确认支付'}}
    </button>
  </view>

  <!-- 安全说明 -->
  <view class="security-info">
    <image class="security-icon" src="/images/security.png" mode="aspectFit"></image>
    <text class="security-text">支付环境安全，请放心支付</text>
  </view>
</view>