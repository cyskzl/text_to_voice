/* pages/payment-result/payment-result.wxss */
.container {
  padding: 40rpx 30rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 加载状态 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
}

.spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #4CAF50;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 30rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #666;
}

/* 结果容器 */
.result-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.result-content {
  background: white;
  border-radius: 30rpx;
  padding: 60rpx 40rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 40rpx rgba(0,0,0,0.1);
  margin-bottom: 40rpx;
}

.result-content.success {
  border-top: 6rpx solid #4CAF50;
}

.result-content.failed {
  border-top: 6rpx solid #f44336;
}

.result-content.cancelled {
  border-top: 6rpx solid #ff9800;
}

.result-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 30rpx;
}

.result-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 15rpx;
}

.result-content.success .result-title {
  color: #4CAF50;
}

.result-content.failed .result-title {
  color: #f44336;
}

.result-content.cancelled .result-title {
  color: #ff9800;
}

.result-desc {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 40rpx;
  text-align: center;
}

/* 订单摘要 */
.order-summary {
  width: 100%;
  background: #f8f9fa;
  border-radius: 20rpx;
  padding: 30rpx;
}

.summary-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.summary-item:last-child {
  margin-bottom: 0;
}

.summary-label {
  font-size: 28rpx;
  color: #666;
}

.summary-value {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.summary-value.amount {
  color: #e74c3c;
  font-size: 32rpx;
}

/* 失败原因 */
.failure-reasons {
  width: 100%;
  background: #fff3cd;
  border-radius: 15rpx;
  padding: 25rpx;
}

.reasons-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #856404;
  margin-bottom: 15rpx;
}

.reason-item {
  display: block;
  font-size: 26rpx;
  color: #856404;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

/* 取消提示 */
.cancel-tips {
  width: 100%;
  background: #e3f2fd;
  border-radius: 15rpx;
  padding: 25rpx;
  text-align: center;
}

.tips-text {
  font-size: 28rpx;
  color: #1976d2;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.action-btn {
  flex: 1;
  border-radius: 50rpx;
  padding: 30rpx;
  font-size: 30rpx;
  font-weight: bold;
  border: none;
}

.action-btn.primary {
  background: linear-gradient(135deg, #4CAF50, #45a049);
  color: white;
}

.action-btn.secondary {
  background: white;
  color: #666;
  border: 2rpx solid #ddd;
}

/* 额外信息 */
.extra-info {
  margin-top: auto;
}

.info-item {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.info-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
}

.info-text {
  font-size: 24rpx;
  color: #999;
}