/* pages/payment-webview/payment-webview.wxss */
.container {
  width: 100%;
  height: 100vh;
  position: relative;
  background-color: #f5f5f5;
}

/* 加载状态 */
.loading-container {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: white;
  z-index: 1000;
}

.loading-spinner {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #4CAF50;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 30rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #666;
}

/* WebView */
web-view {
  width: 100%;
  height: 100vh;
}

/* 重试页面 */
.retry-container {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: white;
}

.retry-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx;
}

.retry-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 30rpx;
}

.retry-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.retry-desc {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
  text-align: center;
}

.retry-button {
  background: linear-gradient(135deg, #4CAF50, #45a049);
  color: white;
  border: none;
  border-radius: 50rpx;
  padding: 25rpx 50rpx;
  font-size: 30rpx;
  font-weight: bold;
}

/* 底部操作栏 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  gap: 20rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.1);
}

.action-button {
  flex: 1;
  border-radius: 50rpx;
  padding: 25rpx;
  font-size: 28rpx;
  font-weight: bold;
  border: none;
}

.action-button.secondary {
  background: #f8f9fa;
  color: #6c757d;
  border: 1rpx solid #dee2e6;
}

.action-button.danger {
  background: linear-gradient(135deg, #dc3545, #c82333);
  color: white;
}

/* 支付状态提示 */
.status-tip {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 2000;
}

.status-content {
  background: white;
  border-radius: 20rpx;
  padding: 60rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 40rpx rgba(0,0,0,0.2);
}

.status-content.success {
  border: 4rpx solid #4CAF50;
}

.status-content.failed {
  border: 4rpx solid #f44336;
}

.status-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
}

.status-text {
  font-size: 32rpx;
  font-weight: bold;
}

.status-content.success .status-text {
  color: #4CAF50;
}

.status-content.failed .status-text {
  color: #f44336;
}